# Server-side only. Set these in Vercel Project -> Settings -> Environment Variables.
# Never put real credentials in source control or use a VITE_ prefix for secrets.
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=quickstocks
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# One-time initial setup protection; do not reuse SESSION_SECRET here.
SETUP_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_24_CHARACTERS
